Options -Indexes

<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.sql$|^README\.md$)">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:app|config|routes|views|storage)/ - [F,L,NC]
  RewriteRule ^(?:\.git|\.env) - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
